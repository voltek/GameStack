# LF in every checkout except .bat/.cmd, whatever core.autocrlf says.
* text=auto eol=lf

gradlew text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

*.jar binary
*.zip binary
*.apk binary
*.aab binary
*.jks binary
*.keystore binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.mp4 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
