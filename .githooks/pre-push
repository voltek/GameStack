#!/bin/sh
# Checked before the push, while a rename is free: renaming an open PR's head
# branch closes the PR.
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case $local_sha in *[!0]*) ;; *) continue ;; esac
    case $remote_ref in refs/heads/*) ;; *) continue ;; esac
    name=${remote_ref#refs/heads/}
    [ "$name" = main ] && continue
    sh "$(dirname "$0")/rules.sh" branch "$name" || status=1
done
exit $status
